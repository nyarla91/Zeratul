  - _key: validator-is-not-friendly
    _line: "\u0426\u0435\u043B\u044C \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439"
  - _key: validator-is-not-hostile
    _line: "\u0426\u0435\u043B\u044C \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u043E\u0439"
  - _key: validator-is-not-uncontrollable
    _line: "\u042D\u0442\u043E\u0433\u043E \u044E\u043D\u0438\u0442\u0430 \u043D\u0435\u043B\u044C\u0437\u044F
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
  - _key: validator-kill-counter
    _line: "\u0423\u0431\u0435\u0439\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u041E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432
      (#)"
  - _key: tutorial-basic-controls
    _line: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 [1] \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438
      \u043D\u0430 \u044E\u043D\u0438\u0442\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0435\u0433\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      \u043C\u044B\u0448\u0438 \u0432 \u0433\u0434\u0435 \u0443\u0433\u043E\u0434\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443 \u044E\u043D\u0438\u0442\u0443
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u044D\u0442\u0443
      \u0442\u043E\u0447\u043A\u0443."
  - _key: tutorial-basic-controls-header
    _line: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - _key: tutorial-camera
    _line: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0440\u0435\u0434\u043D\u044E\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C
      \u043A\u0430\u043C\u0435\u0440\u0443. \u0412\u044B \u0442\u0430\u043A\u0436\u0435
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0434\u043D\u0435\u0441\u0442\u0438
      \u043A\u0443\u0440\u0441\u043E\u0440 \u043A \u043B\u044E\u0431\u043E\u043C\u0443
      \u043A\u0440\u0430\u044E \u044D\u043A\u0440\u0430\u043D\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443
      \u0432 \u044D\u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u043E \u043C\u044B\u0448\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C
      \u0438 \u043E\u0442\u0434\u0430\u043B\u044F\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443."
  - _key: tutorial-camera-header
    _line: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u0440\u043E\u0439"
  - _key: tutorial-vision
    _line: "\u0412\u0441\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u0438\u043C\u0435\u044E\u0442 \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F. \u041E\u043D\u0438
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0432\u0438\u0434\u0435\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043D\u044B \u0438\u043B\u0438
      \u0437\u0430\u0432\u0435\u0441\u044B, \u043A\u0430\u043A \u0442\u0430, \u0447\u0435\u0440\u0435\u0437
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      [Alt] \u0438\u043B\u0438 \u043D\u0430 \u0438\u043A\u043E\u043D\u043A\u0443
      \u0441 \u0433\u043B\u0430\u0437\u0430 \u0432\u043E\u0437\u043B\u0435 \u043C\u0438\u043D\u0438\u043A\u0430\u0440\u0442\u044B,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C
      \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432.\n\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u043E\u043A\u0430\u0436\u0435\u0442\u0435\u0441\u044C \u0432
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u043E\u043D,
      \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u0441\u0435 \u0435\u0433\u043E
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0435\u0433\u043E \u0432\u0438\u0434\u044F\u0442, \u043D\u0430\u043F\u0430\u0434\u0443\u0442
      \u043D\u0430 \u0432\u0430\u0441.\n\n\u0412\u044B\u0439\u0434\u0438\u0442\u0435
      \u0438\u0437 \u043F\u043E\u043B\u044F \u0437\u0440\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u0438 \u043E\u043D\u0438
      \u0432\u0435\u0440\u043D\u0443\u0441\u0442\u044F \u043A \u0441\u0432\u043E\u0438\u043C
      \u043F\u043E\u0441\u0442\u0430\u043C."
  - _key: tutorial-vision-header
    _line: "\u041E\u0431\u043B\u0430\u0441\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438"
  - _key: tutorial-attack
    _line: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u043E\u0439
      \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438 \u043D\u0430
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0433\u043E \u044E\u043D\u0438\u0442\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443 \u044E\u043D\u0438\u0442\u0443
      \u0435\u0433\u043E \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      [A]. \u0437\u0430\u0442\u0435\u043C \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      \u043C\u044B\u0448\u0438 \u0433\u0434\u0435 \u0443\u0433\u043E\u0434\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443 \u044E\u043D\u0438\u0442\u0443
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u044D\u0442\u0443
      \u0442\u043E\u0447\u043A\u0443, \u0430\u0442\u0430\u043A\u0443\u044F \u0432\u0441\u0435\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u043F\u043E
      \u043F\u0443\u0442\u0438."
  - _key: tutorial-attack-header
    _line: "\u0410\u0442\u0430\u043A\u0430"
  - _key: tutorial-shield
    _line: "\u0413\u043E\u043B\u0443\u0431\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0432\u043E\u043A\u0440\u0443\u0433 \u044E\u043D\u0438\u0442\u0430 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
      \u0435\u0433\u043E \u0449\u0438\u0442\u044B. \u041E\u043D\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C, \u043F\u043E\u043A\u0430
      \u044E\u043D\u0438\u0442 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0443\u0440\u043E\u043D\u0430.\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      \u041D\u0415 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C."
  - _key: tutorial-shield-header
    _line: "\u0429\u0438\u0442\u044B"
  - _key: tutorial-stim
    _line: "\u0412\u044B \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438 \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B
      \u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u0445 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D
      \u0440\u0430\u0437, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442\u0435
      \u0435\u0449\u0451.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435 [Z], \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440
      \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
  - _key: tutorial-stim-header
    _line: "\u0421\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B"
  - _key: tutorial-hindrance
    _line: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u0435.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      [Q], \u0437\u0430\u0442\u0435\u043C \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      \u043C\u044B\u0448\u0438 \u043D\u0430 \u044E\u043D\u0438\u0442\u0430, \u0447\u0442\u043E\u0431\u0430
      \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0435\u0433\u043E. \u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u044E\u043D\u0438\u0442\u044B \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u0438\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u044D\u0442\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C."
  - _key: tutorial-hindrance-header
    _line: "\u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u0435"
  - _key: tutorial-pause
    _line: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u0430\u0443\u0437\u0443
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u043A\u043B\u0430\u0432\u0438\u0448\u0443
      [\u041F\u0440\u043E\u0431\u0435\u043B] \u0438\u043B\u0438 \u0438\u043A\u043E\u043D\u043A\u0443
      \u0447\u0430\u0441\u043E\u0432 \u0440\u044F\u0434\u043E\u043C \u0441 \u043C\u0438\u043D\u0438\u043A\u0430\u0440\u0442\u043E\u0439.\n\n\u041F\u043E\u043A\u0430
      \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u0430\u0443\u0437\u0430
      \u0430\u043A\u0442\u0438\u0432\u043D\u0430 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u043B\u0435
      \u0431\u043E\u044F, \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438
      \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u044B
      \u044E\u043D\u0438\u0442\u0430\u043C.\n\n\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      [Shift \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0438\u0437 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432.
      \u0422\u0430\u043A\u0438\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u044B \u0431\u0443\u0434\u0443\u0442
      \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443.\n\n\u041A\u043E\u0433\u0434\u0430
      \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u044B,
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 [\u041F\u0440\u043E\u0431\u0435\u043B],
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443."
  - _key: tutorial-pause-header
    _line: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u0430\u0443\u0437\u0430"
  - _key: tutorial-slice
    _line: "\u041F\u0440\u043E\u043D\u0437\u0430\u043D\u0438\u0435 [W] \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0440\u043E\u043D
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443."
  - _key: tutorial-slice-header
    _line: "\u041F\u0440\u043E\u043D\u0437\u0430\u043D\u0438\u0435"
  - _key: tutorial-parasite
    _line: "\u0412\u0438\u0440\u0443\u0441 [E] \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0432\u0430\u043C \u0432\u0438\u0434\u0435\u0442\u044C \u0432\u0441\u0451,
      \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0442 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439
      \u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u044D\u0442\u043E \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0438
      \u0438\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u044B \u0431\u044B \u043D\u0435
      \u0443\u0432\u0438\u0434\u0435\u043B\u0438."
  - _key: tutorial-parasite-header
    _line: "\u0412\u0438\u0440\u0443\u0441"
  - _key: tutorial-cloak
    _line: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B.\n\n\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043D\u0435 \u0432\u0438\u0434\u044F\u0442 \u0432\u0430\u0441 \u0438 \u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E.\n"
  - _key: tutorial-cloak-header
    _line: "\u041C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0430"
  - _key: tutorial-detectors
    _line: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043C\u043E\u0433\u0443\u0442 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044C
      \u0432\u0430\u0448\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0434\u0430\u0436\u0435 \u0432 \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0435.
      \u041D\u0430\u0445\u043E\u0434\u044F\u0441\u044C \u0432 \u0437\u043E\u043D\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0434\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u0430
      \u0432\u044B \u0442\u0435\u0440\u044F\u0435\u0442\u0435 \u0432\u0441\u0435
      \u043F\u0440\u0438\u0435\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0438
      \u0438 \u0441\u043D\u043E\u0432\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C
      \u0432\u0438\u0434\u043D\u044B \u0434\u043B\u044F \u0432\u0441\u0435\u0445
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432."
  - _key: tutorial-detectors-header
    _line: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u044B"
  - _key: tutorial-enemy-selection
    _line: "\u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0438\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438"
  - _key: tutorial-enemy-selection-header
    _line: "\u0412\u044B\u0431\u043E\u0440 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432"
