  m_Name: RussianTable
  m_EditorClassIdentifier: Loalization::Localization.LanguageTable
  _entries:
  - _key: ability-blink-description
    _line: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442 \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E"
  - _key: ability-blink-name
    _line: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441"
  - _key: ability-invasion-description
    _line: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u043D\u0430\u0434\u043E \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u043C
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u043C \u044E\u043D\u0438\u0442\u043E\u043C
      \u0423 \u0432\u0430\u0441 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445
      <kw>\u044F\u0447\u0435\u0435\u043A \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F</kw>"
  - _key: ability-invasion-name
    _line: "\u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435"
  - _key: ability-lockdown-description
    _line: "<kw>\u0411\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442</kw> \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u044E\u043D\u0438\u0442\u0430 \u043D\u0430 6 \u0441\u0435\u043A. \u0411\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0430
      \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u044E\u043D\u0438\u0442\u0443
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0438
      \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438."
  - _key: ability-lockdown-name
    _line: "\u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u0435"
  - _key: ability-stat-cooldown
    _line: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435:
      # \u0441\u0435\u043A."
  - _key: ability-stat-energy
    _line: "\u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C: # \u044D\u043D\u0435\u0440\u0433\u0438\u0438"
  - _key: ability-stat-range
    _line: "\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C: #"
  - _key: order
    _line: "\u041F\u0440\u0438\u043A\u0430\u0437"
  - _key: order-ability
    _line: "\u041F\u0440\u0438\u043A\u0430\u0437 \u2014 \u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
  - _key: order-attack-description
    _line: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u044E\u043D\u0438\u0442\u0430 \u0438\u043B\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043A \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0435,
      \u0430\u0442\u0430\u043A\u0443\u044F \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432 \u043D\u0430 \u0441\u0432\u043E\u0451\u043C
      \u043F\u0443\u0442\u0438."
  - _key: order-attack-name
    _line: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C"
  - _key: order-hold-position-description
    _line: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u044E\u043D\u0438\u0442\u0443
      \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
  - _key: order-hold-position-name
    _line: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0437\u0438\u0446\u0438\u044E"
  - _key: order-move-description
    _line: "\u0414\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043A \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u0435 \u0438\u043B\u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430 \u0432\u044B\u0431\u0430\u043D\u043D\u044B\u043C \u044E\u043D\u0438\u0442\u043E\u043C."
  - _key: order-move-name
    _line: "\u0414\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
  - _key: order-stop-description
    _line: "\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u0432\u0441\u0435 \u0442\u0435\u043A\u0443\u0449\u0438\u0435
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B."
  - _key: order-stop-name
    _line: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F"
  - _key: ordererror-ability-not-ready
    _line: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043D\u0435
      \u0433\u043E\u0442\u043E\u0432\u0430"
  - _key: ordererror-cannot-attack
    _line: "\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C"
  - _key: ordererror-cannot-move
    _line: "\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
  - _key: ordererror-cannot-target-self
    _line: "\u041D\u0435\u043B\u044C\u0437\u044F \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
      \u0446\u0435\u043B\u044C\u044E \u0441\u0435\u0431\u044F"
  - _key: ordererror-generic
    _line: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E"
  - _key: ordererror-locked
    _line: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B"
  - _key: ordererror-must-target-unit
    _line: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u044E\u043D\u0438\u0442\u0430"
  - _key: ordererror-not-enough-energy
    _line: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438"
  - _key: ordererror-out-of-range
    _line: "\u0426\u0435\u043B\u044C \u0432\u043D\u0435 \u0434\u043E\u0441\u044F\u0433\u0430\u0435\u043C\u043E\u0441\u0442\u0438"
  - _key: ordererror-passive
    _line: "\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u0443\u044E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
  - _key: ordererror-target-invalid
    _line: "\u041D\u0435\u0432\u0435\u0440\u043D\u0430\u044F \u0446\u0435\u043B\u044C"
  - _key: status
    _line: "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435"
  - _key: status-cloaked-description
    _line: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0446\u0435\u043B\u044C\u044E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u0430\u0442\u0430\u043A \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u0435\u0441\u043B\u0438 \u043E\u043D \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D"
  - _key: status-cloaked-name
    _line: "\u041C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0430"
  - _key: status-detected-description
    _line: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0446\u0435\u043B\u044C\u044E
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u0430\u0442\u0430\u043A
      \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043E\u043D \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D"
  - _key: status-detected-name
    _line: "\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D"
  - _key: status-detector-description
    _line: "\u041C\u043E\u0436\u0435\u0442 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044C
      \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u044E\u043D\u0438\u0442\u043E\u0432
      \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438"
  - _key: status-detector-name
    _line: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440"
  - _key: status-duration
    _line: "<stat># \u0441\u0435\u043A. \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C</stat>"
  - _key: status-invasion-description
    _line: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u043D\u0430\u0434 \u044D\u0442\u0438\u043C \u044E\u043D\u0438\u0442\u043E\u043C"
  - _key: status-invasion-name
    _line: "\u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435"
  - _key: status-locked-description
    _line: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
      \u0438 \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438"
  - _key: status-locked-name
    _line: "\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D"
  - _key: status-shield-battery-description
    _line: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0449\u0438\u0442\u044B \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432 \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438"
  - _key: status-shield-battery-name
    _line: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u0449\u0438\u0442\u043E\u0432"
  - _key: status-temporary-description
    _line: "\u0418\u043C\u0435\u0435\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0436\u0438\u0437\u043D\u0438"
  - _key: status-temporary-name
    _line: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439"
  - _key: tutorial-attack-description
    _line: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u043E\u0439
      \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438 \u043D\u0430
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443
      \u044E\u043D\u0438\u0442\u0443 \u0435\u0433\u043E \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C"
  - _key: tutorial-attack-label
    _line: "\u0410\u0442\u0430\u043A\u0430"
  - _key: tutorial-order-description
    _line: "\u0427\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u0441\u0440\u0430\u0437\u0443 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u044E\u043D\u0438\u0442\u043E\u0432, \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435
      \u043F\u043E \u043D\u0438\u043C \u043C\u044B\u0448\u043A\u043E\u0439 \u0441
      \u0437\u0430\u0436\u0430\u0442\u043E\u0439 \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439.\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \"\"\u0410\u0442\u0430\u043A\u0430\"\" (A), \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u044E\u043D\u0438\u0442\u0430\u043C
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C\u0441\u044F \u0432
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u0442\u043E\u0447\u043A\u0443,
      \u0430\u0442\u0430\u043A\u0443\u044F \u0432\u0441\u0435\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u043F\u0443\u0442\u0438 \u0438\u043B\u0438
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
      \u044F\u0447\u0435\u0439\u043A\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F.\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \"\"\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\"\" (S), \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u0432\u0441\u0435 \u0442\u0435\u043A\u0443\u0449\u0438\u0435
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432.\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \"\"\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0437\u0438\u0446\u0438\u044E\"\"
      (D), \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C
      \u044E\u043D\u0438\u0442\u0430\u043C \u043D\u0435 \u0441\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0441 \u043C\u0435\u0441\u0442\u0430."
  - _key: tutorial-order-label
    _line: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u044E\u043D\u0438\u0442\u0430\u043C\u0438"
  - _key: tutorial-basic-controls-description
    _line: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043B\u0435\u0432\u043E\u0439
      \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438 \u043D\u0430
      \u0441\u0432\u043E\u0435\u0433\u043E \u044E\u043D\u0438\u0442\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0435\u0433\u043E.\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      \u043C\u044B\u0448\u0438 \u0432 \u043B\u044E\u0431\u043E\u043C \u043C\u0435\u0441\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443 \u044E\u043D\u0438\u0442\u0443
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u044D\u0442\u0443
      \u0442\u043E\u0447\u043A\u0443"
  - _key: tutorial-basic-controls-label
    _line: "\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - _key: tutorial-camera-description
    _line: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443
      \u0437\u0430\u0436\u043C\u0438\u0442\u0435 \u0441\u0440\u0435\u0434\u043D\u044E\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0438\u043B\u0438
      \u043F\u043E\u0434\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u0443\u0440\u0441\u043E\u0440
      \u043A \u043A\u0440\u0430\u044E \u044D\u043A\u0440\u0430\u043D\u0430\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u043E \u043C\u044B\u0448\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u043C\u0435\u0440\u0443"
  - _key: tutorial-camera-label
    _line: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u0440\u043E\u0439"
  - _key: tutorial-cloak-description
    _line: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B.\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0441 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E, \u0434\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C
      \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0438\u0445 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438."
  - _key: tutorial-cloak-label
    _line: "\u041C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0430"
  - _key: tutorial-control-description
    _line: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432. \u043F\u043E\u043A\u0430 \u0443 \u0432\u0430\u0441
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445
      \u044F\u0447\u0435\u0435\u043A \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F.\u0423\u0431\u0438\u0432\u0430\u0439\u0442\u0435
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u044E\u043D\u0438\u0442\u043E\u0432,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
      \u044F\u0447\u0435\u0439\u043A\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F."
  - _key: tutorial-control-label
    _line: "\u042F\u0447\u0435\u0439\u043A\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F"
  - _key: tutorial-detectors-description
    _line: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u044B \u043C\u043E\u0433\u0443\u0442
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u0432\u0430\u0441
      \u0434\u0430\u0436\u0435 \u0432 \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0435.\u041F\u043E\u043A\u0430
      \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0434\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u0430,
      \u0432\u0430\u0448\u0430 \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0430
      \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0443\u0435\u0442.\u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u0435
      \u0442\u0430\u043A\u0436\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u044D\u0442\u0443 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C."
  - _key: tutorial-detectors-label
    _line: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u044B"
  - _key: tutorial-energy-description
    _line: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043B\u0432\u0430\u043D\u0438\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u044E\u043D\u0438\u0442\u0430.\u042D\u043D\u0435\u0440\u0433\u0438\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C"
  - _key: tutorial-energy-label
    _line: "\u042D\u043D\u0435\u0440\u0433\u0438\u044F"
  - _key: tutorial-invasion-description
    _line: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435
      (T), \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u043F\u043E\u043B\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u043D\u0430\u0434 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C.\u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u0432\u0430\u0448\u0438
      \u044F\u0447\u0435\u0439\u043A\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F,
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u044E\u043D\u0438\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C."
  - _key: tutorial-invasion-label
    _line: "\u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435"
  - _key: tutorial-life-description
    _line: "\u041F\u043E\u043C\u0438\u043C\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0443 \u044E\u043D\u0438\u0442\u043E\u0432 \u0435\u0441\u0442\u044C \u0449\u0438\u0442\u044B.\u0429\u0438\u0442\u044B
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E, \u043F\u043E\u043A\u0430
      \u044E\u043D\u0438\u0442 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0443\u0440\u043E\u043D.\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043D\u0435
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
  - _key: tutorial-life-label
    _line: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0438 \u0449\u0438\u0442\u044B"
  - _key: tutorial-save-description
    _line: "\u0412 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0436\u0430\u0442\u044C F5. \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443.\u041D\u0430\u0436\u043C\u0438\u0442\u0435 F8, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435."
  - _key: tutorial-save-label
    _line: "\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0430"
  - _key: tutorial-hinderance-description
    _line: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u0435.\u0414\u043B\u044F
      \u044D\u0442\u043E\u0433\u043E \u043D\u0430\u0436\u043C\u0438\u0442\u0435 Q,
      \u0437\u0430\u0442\u0435\u043C \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      \u043C\u044B\u0448\u0438 \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
      \u043F\u0440\u043E\u0442\u0438\u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C.\u042E\u043D\u0438\u0442\u044B
      \u043F\u043E\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u044F
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438."
  - _key: tutorial-hinderance-label
    _line: "\u041F\u0440\u0435\u0440\u044B\u0432\u0430\u043D\u0438\u0435"
  - _key: tutorial-tactical-pause-description
    _line: "\u0412 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0436\u0430\u0442\u044C \u041F\u0440\u043E\u0431\u0435\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u0430\u0443\u0437\u0443.\u0412\u043E
      \u0432\u0440\u0435\u043C\u044F \u043F\u0430\u0443\u0437\u044B \u0438\u0433\u0440\u0430
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u044B \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u043F\u043E\u043B\u0435 \u0431\u043E\u044F, \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438
      \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u044B
      \u044E\u043D\u0438\u0442\u0430\u043C.\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u044B
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
      Shift. \u0422\u0430\u043A\u0438\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u044B
      \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443.\u041A\u0430\u043A
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B \u0433\u043E\u0442\u043E\u0432\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u0433\u0440\u0443,
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u041F\u0440\u043E\u0431\u0435\u043B
      \u0441\u043D\u043E\u0432\u0430."
  - _key: tutorial-tactical-pause-label
    _line: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u0430\u0443\u0437\u0430"
  - _key: tutorial-vision-description
    _line: "\u0423 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432,
      \u0442\u0430\u043A\u0436\u0435 \u043A\u0430\u043A \u0438 \u0443 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u044B.\u0414\u043B\u044F \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C
      \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      Alt."
